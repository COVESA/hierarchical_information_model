HIM:
  type: branch
  description: Contains the set of trees that a server manages as one virtual domain.


HIM.Vehicle:
  type: direct
  domain: Vehicle.COVESA.OEMX.ModelY.VehicleData
  version: X.Y.Z
  typesdef: Vehicle.COVESA.TypeDef+X.Y.Z
  local: file://<full-path-name>
  public: https://himrepo.oem.com?instance=Vehicle.COVESA.OEMX.ModelY.VehicleData.X.Y.Z
  description:  Vehicle signal tree that contains references to a type definition tree.

HIM.VehicleServices:
  type: direct
  domain: Vehicle.COVESA.OEMX.ModelY.Service
  version: X.Y.Z
  local: file://<full-path-name>
  public: https://himrepo.oem.com?instance=Vehicle.COVESA.OEMX.ModelY.Service.X.Y.Z
  description:  Vehicle service tree.

HIM.Types:
  type: direct
  domain: Vehicle.COVESA.TypeDef
  version: X.Y.Z
  local: file://<full-path-name>
  public: https://himrepo.oem.com?instance=Vehicle.COVESA.TypeDef.X.Y.Z
  description:  Type definition tree.
