# The vehicle branch for highlevel vehicle signals and attributes.
#
Vehicle:
  type: branch
  description: High-level vehicle data.
#
# Vehicle identification attributes.
#

Vehicle.VehicleIdentification:
  type: branch
  description: Attributes that identify a vehicle.

Vehicle.VehicleIdentification.VIN:
  datatype: string
  type: attribute
  default: WXYZ1234567890123
  description: 17-character Vehicle Identification Number (VIN) as defined by ISO 3779.

Vehicle.VehicleIdentification.WMI:
  datatype: string
  type: attribute
  default: WXY
  description: 3-character World Manufacturer Identification (WMI) as defined by ISO 3780.

Vehicle.VehicleIdentification.Brand:
  datatype: string
  type: attribute
  default: OEMX
  description: Vehicle brand or manufacturer.

Vehicle.VehicleIdentification.Model:
  datatype: string
  type: attribute
  default: ModelY
  description: Vehicle model.

Vehicle.VehicleIdentification.Year:
  datatype: uint16
  type: attribute
  default: 2026
  description: Model year of the vehicle.

Vehicle.Identifier:
  type: branch
  description: Vehicle tree identification data.

Vehicle.Identifier.Domain:
  datatype: string
  type: attribute
  default: Vehicle.COVESA.OEMX.ModelY.VehicleData
  description: Tree domain.

Vehicle.Identifier.Version:
  type: branch
  description: Supported Version.

Vehicle.Identifier.Version.Major:
  datatype: uint32
  type: attribute
  default: 4
  description: Major version.

Vehicle.Identifier.Version.Minor:
  datatype: uint32
  type: attribute
  default: 1
  description: Minor version.

Vehicle.Identifier.Version.Patch:
  datatype: uint32
  type: attribute
  default: 0
  description: Patch version.
